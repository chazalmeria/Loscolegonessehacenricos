# Copia este archivo como ".env" y ajusta los valores (solo hace falta para USO LOCAL;
# en Vercel estas mismas variables se configuran en el panel del proyecto, Settings -> Environment Variables).

# Puerto donde arranca el servidor en local (Vercel ignora esto)
PORT=3000

# Contraseña compartida para entrar con cualquiera de los 7 usuarios
SHARED_PASSWORD=MaximianoGuapo

# Frase secreta usada para firmar la cookie de sesion (pon cualquier cadena larga y aleatoria)
COOKIE_SECRET=cambia-esto-por-algo-largo-y-aleatorio

# Token secreto para el endpoint que actualiza la jornada automaticamente (usado por la tarea programada de Claude)
ADMIN_UPDATE_TOKEN=cambia-esto-tambien

# --- Base de datos (Turso) ---
# Si las dejas vacias, la app usa un archivo SQLite local (data/quiniela.db) automaticamente:
# perfecto para probar en tu ordenador, pero NO sirve para Vercel (su disco no es persistente).
# Para produccion en Vercel, crea una base en https://turso.tech y pon aqui sus valores:
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# API key de https://loteriasapi.com para traer jornadas y resultados de La Quiniela
LOTERIAS_API_KEY=

# Secreto con el que Vercel llama al cron diario (/api/admin/sync). En local no hace falta.
CRON_SECRET=
